<script>
  (function() {
    // 1. Interactive Filter Chips
    const chips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll('.gallery-card');

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => {
          c.classList.remove('bg-primary-container', 'text-on-primary', 'active', 'ring-primary-container');
          c.classList.add('bg-surface-container-lowest', 'text-on-surface-variant', 'ring-neutral-200');
        });
        chip.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant', 'ring-neutral-200');
        chip.classList.add('bg-primary-container', 'text-on-primary', 'active', 'ring-primary-container');

        const filter = chip.getAttribute('data-filter');
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Built-in Lightbox Script
    const lightboxModal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-image');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    // Collect all elements with data-lightbox-trigger
    const triggers = Array.from(document.querySelectorAll('[data-lightbox-trigger="true"]'));
    let currentIndex = 0;

    function openLightbox(index) {
      currentIndex = index;
      const target = triggers[currentIndex];
      const fullImg = target.getAttribute('data-full-img');
      const caption = target.getAttribute('data-caption') || 'Creative Proof Preview';

      lightboxImg.src = fullImg;
      lightboxCaption.textContent = caption;
      lightboxCounter.textContent = (currentIndex + 1) + ' of ' + triggers.length;

      lightboxModal.classList.remove('hidden');
      lightboxModal.classList.add('flex');
      // smooth fade in
      setTimeout(() => {
        lightboxModal.classList.remove('opacity-0');
        lightboxModal.classList.add('opacity-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightboxModal.classList.remove('opacity-100');
      lightboxModal.classList.add('opacity-0');
      setTimeout(() => {
        lightboxModal.classList.remove('flex');
        lightboxModal.classList.add('hidden');
        lightboxImg.src = '';
      }, 200);
      document.body.style.overflow = '';
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % triggers.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + triggers.length) % triggers.length;
      openLightbox(currentIndex);
    }

    triggers.forEach((trigger, idx) => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(idx);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });

    // Close when clicking outside image
    lightboxModal.addEventListener('click', (e) => {
      if (e.target === lightboxModal || e.target.classList.contains('backdrop-blur-md')) {
        closeLightbox();
      }
    });

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      if (lightboxModal.classList.contains('flex')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') showNext();
        if (e.key === 'ArrowLeft') showPrev();
      }
    });
  })();
</script></div></main><footer class="w-full bg-[#0F172A] text-slate-300 py-space-xl"><div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-space-xl pb-space-xl"><div class="lg:col-span-4 flex flex-col gap-space-md"><div class="flex items-center gap-space-sm"><img alt="GrowthMark Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1XGKSbm3RFFZB9dJT5FXqTLSJskOTa4QinPvhakKtSH9uqfb2dj98jgtJfu-W7M3hFJX0rr5tMc410rGkG0qOCCv2E83mWAM6zp24cvUoGrZ3IZ765oFl5HOKYYs4JBlibbaV_oqFFSsuO_aPgZWVQ-o-NSljkqIeqOW23FIIzhwzuPp9uzBq2s0EM7q7-8O5SRbJWivDqMjBc1_yX3Tq-gXVnpA_JYXzcNV1SsuvlP"/><span class="font-headline-md text-headline-md text-white font-bold">Alex Rivera</span></div><p class="font-body-sm text-body-sm text-slate-400 max-w-sm">Helping brands scale with data-driven SEO, performance marketing, and high-impact analytics.</p><div class="flex items-center gap-space-md pt-space-xs"><a aria-label="LinkedIn" class="text-slate-400 hover:text-white transition-colors" href="#"><span class="material-symbols-outlined">public</span></a><a aria-label="Instagram" class="text-slate-400 hover:text-white transition-colors" href="#"><span class="material-symbols-outlined">photo_camera</span></a><a aria-label="X (Twitter)" class="text-slate-400 hover:text-white transition-colors" href="#"><span class="material-symbols-outlined">tag</span></a><a aria-label="YouTube" class="text-slate-400 hover:text-white transition-colors" href="#"><span class="material-symbols-outlined">play_circle</span></a></div></div><div class="lg:col-span-2 flex flex-col gap-space-sm"><h3 class="font-label-md text-label-md text-white uppercase tracking-wider mb-space-xs font-semibold">Quick Links</h3><ul class="flex flex-col gap-space-sm font-body-sm text-body-sm"><li class="list-none"><a class="text-slate-400 hover:text-white transition-colors" data-path="home" href="#">Home</a></li><li class="list-none"><a class="text-s